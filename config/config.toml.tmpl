# zeroclaw-k3s-sre — configuration template
#
# Rendered by entrypoint.sh with `envsubst` into $ZEROCLAW_CONFIG_DIR/config.toml
# at container start. NOTHING SECRET IS SUBSTITUTED HERE.
#
# Every credential (LLM key, Slack tokens, Discord token, gateway bearer,
# webhook secret) is injected into the in-memory Config by ZeroClaw's
# ZEROCLAW_<dotted__path> env-override layer, which never writes to disk.
# See NOTES.md §2 and deploy/secret.example.yaml for the exact variable names.
#
# Only these placeholders are substituted (all non-secret):
#   ZC_PROVIDER_FAMILY ZC_MODEL ZC_DATA_DIR ZC_WORKSPACE_DIR ZC_SANDBOX_BACKEND
#   ZC_AGENT_CHANNELS_TOML ZC_DIGEST_CHANNEL_REF ZC_FANOUT_CHANNEL_REF
#   ZC_FANOUT_INSTRUCTION ZC_SLACK_ENABLED ZC_DISCORD_ENABLED
#   SLACK_CHANNEL_IDS_TOML SLACK_DIGEST_CHANNEL
#   DISCORD_GUILD_IDS_TOML DISCORD_CHANNEL_IDS_TOML DISCORD_DIGEST_CHANNEL
#   ZC_ALLOWED_USERS_SLACK_TOML ZC_ALLOWED_USERS_DISCORD_TOML
#   SWEEP_CRON RIGHTSIZE_CRON HEARTBEAT_CRON
#   ALLOWED_NAMESPACES GH_REPO ZC_WEBHOOK_PORT

schema_version = 3

# ── Model provider ───────────────────────────────────────────────
# The family is a template variable so this distribution is not welded to one
# vendor: `anthropic` by default, but any family ZeroClaw knows works — set
# ZC_PROVIDER_FAMILY and a matching ZC_MODEL. The key arrives as
# ZEROCLAW_providers__models__<family>__sre__api_key, exported by entrypoint.sh.
[providers.models.${ZC_PROVIDER_FAMILY}.sre]
model = "${ZC_MODEL}"
temperature = 0.0

# ── Risk profile (autonomy) ──────────────────────────────────────
# `supervised`: low-risk tool calls run, medium-risk ones ask in chat,
# high-risk ones are blocked. RBAC (deploy/rbac.yaml) is the hard boundary;
# this is defense in depth.
[risk_profiles.sre]
level = "supervised"
workspace_only = false
# Medium-risk tools run without asking. Enumerating them instead does not work:
# the agent reaches for cron_list, http_request, web_search_tool, git_forge and
# more as it investigates, and every tool missing from the allowlist becomes an
# approval card that buries the channel. Whack-a-mole with a list that is wrong
# again the next time the model picks a different tool.
#
# What still gates the things that matter:
#   - block_high_risk_commands below: unknown shell commands are refused, not asked;
#   - always_ask below: file writes always prompt;
#   - requires_confirmation on every mutating SOP step: rightsize, release and
#     prune cannot change anything without an operator approving in chat;
#   - RBAC, which no prompt can talk its way past.
require_approval_for_medium_risk = false
block_high_risk_commands = true
# Strict allowlist: anything not named here is refused by the shell policy.
allowed_commands = [
  "kubectl", "gh", "jq", "sh", "curl",
  "echo", "date", "grep", "head", "tail", "sort", "uniq", "wc", "cut", "tr", "awk",
]
# The agent's *file* tools may not read these; kubectl still authenticates
# from the projected ServiceAccount token because the sandbox is disabled
# in-cluster (NOTES.md §6) and path policy applies to tool arguments, not to
# a subprocess's own opens.
forbidden_paths = [
  "/etc", "/sys", "/boot", "/proc",
  "/var/run/secrets", "/run/secrets",
  "~/.ssh", "~/.aws", "~/.kube",
]
shell_env_passthrough = [
  "PATH", "HOME", "LANG",
  "KUBERNETES_SERVICE_HOST", "KUBERNETES_SERVICE_PORT",
  "GH_TOKEN", "GH_REPO", "ALLOWED_NAMESPACES", "SWEEP_STATE_DIR",
]
# Explicitly always-allowed, regardless of how a tool is classified. Mostly
# redundant now that medium-risk runs unattended, but it states the intent and
# survives a reclassification upstream. NOTES.md §18.
auto_approve = [
  # cluster inspection
  "shell",
  # its own bookkeeping
  "file_read", "memory_recall", "memory_store", "glob_search", "content_search",
  "tool_search",
  # procedure control — the SOP's own gates are the real check
  "sop_status", "sop_advance", "sop_list", "sop_execute",
  # talking to humans, which is the entire point
  "send_via", "ask_user", "escalate_to_human", "reaction", "poll",
  # GitHub. Gating this protected nothing once `shell` was auto-approved and
  # `gh` is an allowed command — the agent could already do anything the token
  # permits. The real control on GitHub reach is GH_TOKEN's own scopes.
  "git_forge",
]
# Writing files in the workspace is never part of the job; if the model wants
# to, a human should see why.
always_ask = ["file_write", "file_edit"]
sandbox_backend = "${ZC_SANDBOX_BACKEND}"

# ── Runtime profile ──────────────────────────────────────────────
[runtime_profiles.sre]
agentic = true
max_tool_iterations = 40
max_tool_result_chars = 12000
shell_timeout_secs = 60

# ── Skills ───────────────────────────────────────────────────────
# Absolute on purpose: a relative bundle directory resolves against the install
# root, not the agent workspace, which would look in the wrong place.
[skill_bundles.k3s]
directory = "${ZC_WORKSPACE_DIR}/skills"

[skills]
# TEST.sh must be runnable for `zeroclaw skills test k3s-admin` to mean anything.
allow_scripts = true
open_skills_enabled = false
prompt_injection_mode = "full"

# ── The agent ────────────────────────────────────────────────────
[agents.sre]
enabled = true
model_provider = "${ZC_PROVIDER_FAMILY}.sre"
risk_profile = "sre"
runtime_profile = "sre"
channels = [${ZC_AGENT_CHANNELS_TOML}]
skill_bundles = ["k3s"]
cron_jobs = ["sweep", "rightsize", "heartbeat"]

[agents.sre.workspace]
path = "${ZC_WORKSPACE_DIR}"

[agents.sre.memory]
backend = "sqlite"

# ── Channels ─────────────────────────────────────────────────────
# Slack over Socket Mode: bot_token + app_token, no public URL, no signing
# secret (see NOTES.md §4 — 0.8.x SlackConfig has no signing_secret field).
[channels.slack.ops]
enabled = ${ZC_SLACK_ENABLED}
channel_ids = [${SLACK_CHANNEL_IDS_TOML}]
mention_only = true
thread_replies = true
# Draft streaming posts a placeholder ("Organizing…") and edits it as tokens
# arrive. When a turn ends by posting a *new* message instead — which is what
# happens after a tool-heavy investigation — the placeholder is never finalised
# and sits there looking like the agent is still thinking. Off until upstream
# reconciles the two paths. NOTES.md §20.
stream_drafts = false

# Discord over its outbound gateway.
[channels.discord.ops]
enabled = ${ZC_DISCORD_ENABLED}
guild_ids = [${DISCORD_GUILD_IDS_TOML}]
channel_ids = [${DISCORD_CHANNEL_IDS_TOML}]
mention_only = true
listen_to_bots = false

# Not a listener. This block exists solely so the gateway picks up
# `secret` and enforces `X-Webhook-Secret` on POST /webhook
# (zeroclaw-gateway/src/lib.rs: config.channels.webhook.values().next()).
# The secret arrives as ZEROCLAW_channels__webhook__alerts__secret.
[channels.webhook.alerts]
enabled = false
port = ${ZC_WEBHOOK_PORT}

# ── Operator roster ──────────────────────────────────────────────
# 0.8.x dropped per-channel `allowed_users`; the operator roster that may
# approve mutations is the peer group's `external_peers` (NOTES.md §4).
[peer_groups.ops_slack]
channel = "slack.ops"
agents = ["sre"]
external_peers = [${ZC_ALLOWED_USERS_SLACK_TOML}]

[peer_groups.ops_discord]
channel = "discord.ops"
agents = ["sre"]
external_peers = [${ZC_ALLOWED_USERS_DISCORD_TOML}]

# ── Scheduled work ───────────────────────────────────────────────
# SOP cron triggers start a run but cannot execute steps headlessly (no agent
# loop on the scheduler tick), so the schedule lives here as an *agent* job
# that enters the SOP through the `sop_execute` tool. NOTES.md §5.
[scheduler]
enabled = true
catch_up_on_startup = false

[cron.sweep]
name = "k3s health sweep"
job_type = "agent"
schedule = { kind = "cron", expr = "${SWEEP_CRON}" }
uses_memory = true
session_target = "isolated"
prompt = """
Run the crashloop-sweep SOP now: call sop_execute with name "crashloop-sweep" and follow its steps.
Namespaces in scope: ${ALLOWED_NAMESPACES}.
Silence means healthy: if every pod in scope is Running or Succeeded, post nothing at all and reply exactly SWEEP_CLEAN.
${ZC_FANOUT_INSTRUCTION}
"""

[cron.sweep.delivery]
mode = "announce"
channel = "${ZC_DIGEST_CHANNEL_REF}"
to = "${SLACK_DIGEST_CHANNEL}"
best_effort = true

[cron.rightsize]
name = "k3s rightsizing proposal"
job_type = "agent"
schedule = { kind = "cron", expr = "${RIGHTSIZE_CRON}" }
uses_memory = true
session_target = "isolated"
prompt = """
Run the rightsize SOP now: call sop_execute with name "rightsize" and follow its steps.
Namespaces in scope: ${ALLOWED_NAMESPACES}.
Stop at the approval gate. Never patch anything before an operator approves in chat.
${ZC_FANOUT_INSTRUCTION}
"""

[cron.rightsize.delivery]
mode = "announce"
channel = "${ZC_DIGEST_CHANNEL_REF}"
to = "${SLACK_DIGEST_CHANNEL}"
best_effort = true

[cron.heartbeat]
name = "daily liveness heartbeat"
job_type = "agent"
schedule = { kind = "cron", expr = "${HEARTBEAT_CRON}" }
uses_memory = false
session_target = "isolated"
prompt = """
Post the daily heartbeat. Run `kubectl get nodes --no-headers | wc -l` and
`kubectl get pods --all-namespaces --no-headers | wc -l`, then post ONE line:
"heartbeat OK — <n> nodes, <n> pods, sweeps running, last finding: <fingerprint or none>".
${ZC_FANOUT_INSTRUCTION}
Do not investigate anything. Do not open tickets.
"""

[cron.heartbeat.delivery]
mode = "announce"
channel = "${ZC_DIGEST_CHANNEL_REF}"
to = "${SLACK_DIGEST_CHANNEL}"
best_effort = true

# ── SOPs ─────────────────────────────────────────────────────────
[sop]
sops_dir = "${ZC_WORKSPACE_DIR}/sops"
default_execution_mode = "supervised"
max_concurrent_total = 2
approval_timeout_secs = 1800
approval_timeout_action = "escalate"
persist_runs = true
run_store_backend = "sqlite"
untrusted_input_guard = "warn"
untrusted_outbound_redact = true

# ── Gateway ──────────────────────────────────────────────────────
# Binds 0.0.0.0 because kubelet probes hit the pod IP. The Service publishes
# only the alert-adapter port; 42617 is never exposed outside the pod.
# `paired_tokens` is pre-seeded from ZEROCLAW_gateway__paired_tokens so the
# adapter can authenticate without an interactive `POST /pair`. NOTES.md §3.
[gateway]
host = "0.0.0.0"
port = 42617
allow_public_bind = true
require_pairing = true
allow_remote_admin = false
check_updates = false
allow_self_upgrade = false
webhook_rate_limit_per_minute = 120
idempotency_ttl_secs = 900
# A real investigation is a multi-step agentic turn: enumerate, describe, read
# events, tail logs, resolve the owning workload. The default 30s cuts the HTTP
# request off long before that finishes, so an Alertmanager alert would be
# truncated on every single call. 10 minutes matches ZeroClaw's own
# long-running route budget. NOTES.md §13.
request_timeout_secs = 600
long_running_request_timeout_secs = 900

# ── State ────────────────────────────────────────────────────────
# `memory.backend` is a *reference* to a storage instance, not a backend name:
# "sqlite" resolves to storage.sqlite.default, which has to exist. Without this
# block the daemon starts with "Memory: none" and silently forgets every
# fingerprint between sweeps — which would quietly break the escalation ladder
# and ticket dedupe. NOTES.md §12.
# The instance must exist for the reference above to resolve; the runtime owns
# the file layout underneath it (<install root>/data/{memory,sop,cron}/*.db),
# which is on the PVC either way.
[storage.sqlite.default]
open_timeout_secs = 15

[memory]
backend = "sqlite.default"
auto_save = true
audit_enabled = true

[secrets]
# The encrypted store is unused: no credential is ever written to config.toml,
# so there is nothing to encrypt and no key file to back up or lose.
encrypt = false

[observability]
backend = "prometheus"
log_tool_io = true

[heartbeat]
enabled = false
